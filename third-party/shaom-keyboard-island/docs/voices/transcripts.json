{
  "intro-2": {
    "url": "voices/intro-2.mp3",
    "duration": 3.09,
    "text": "哎呀，小桥断了。一起修好它吧！"
  },
  "intro-3": {
    "url": "voices/intro-3.mp3",
    "duration": 2.987,
    "text": "听，青蛙在打鼓！你也来试试。"
  },
  "intro-0": {
    "url": "voices/intro-0.mp3",
    "duration": 3.547,
    "text": "咦，小灯还没亮呢。我们叫醒萤火虫吧！"
  },
  "intro-1": {
    "url": "voices/intro-1.mp3",
    "duration": 2.533,
    "text": "豆豆要出发啦，帮它划划小船吧！"
  },
  "intro-5": {
    "url": "voices/intro-5.mp3",
    "duration": 2.126,
    "text": "天黑啦，我们把灯塔点亮吧！"
  },
  "intro-4": {
    "url": "voices/intro-4.mp3",
    "duration": 2.523,
    "text": "风来啦！让小风筝飞起来吧。"
  },
  "intro-7": {
    "url": "voices/intro-7.mp3",
    "duration": 2.033,
    "text": "看，向日葵在找太阳呢！"
  },
  "intro-6": {
    "url": "voices/intro-6.mp3",
    "duration": 2.519,
    "text": "小种子睡醒啦，帮它钻出泥土吧。"
  },
  "intro-8": {
    "url": "voices/intro-8.mp3",
    "duration": 2.694,
    "text": "小花渴啦。让风车转起来吧！"
  },
  "intro-9": {
    "url": "voices/intro-9.mp3",
    "duration": 2.354,
    "text": "嗡嗡嗡，小蜜蜂要去采蜜啦！"
  },
  "intro-10": {
    "url": "voices/intro-10.mp3",
    "duration": 2.89,
    "text": "苹果熟啦！接住，别让它掉地上。"
  },
  "intro-11": {
    "url": "voices/intro-11.mp3",
    "duration": 2.632,
    "text": "彩虹还差一点颜色，我们来帮忙！"
  },
  "intro-12": {
    "url": "voices/intro-12.mp3",
    "duration": 2.722,
    "text": "包裹准备好啦，让气球带它出发吧！"
  },
  "intro-13": {
    "url": "voices/intro-13.mp3",
    "duration": 2.526,
    "text": "小火车等着呢，给它装上车轮吧！"
  },
  "intro-14": {
    "url": "voices/intro-14.mp3",
    "duration": 2.639,
    "text": "啵！小鱼想吹一串大泡泡。"
  },
  "intro-15": {
    "url": "voices/intro-15.mp3",
    "duration": 2.842,
    "text": "雪花飘来啦，做一枚雪花印章吧！"
  },
  "intro-16": {
    "url": "voices/intro-16.mp3",
    "duration": 2.744,
    "text": "星星藏在哪儿呢？转转望远镜吧。"
  },
  "intro-17": {
    "url": "voices/intro-17.mp3",
    "duration": 2.311,
    "text": "小猫的信来啦，帮忙送到家吧！"
  },
  "intro-19": {
    "url": "voices/intro-19.mp3",
    "duration": 2.76,
    "text": "咔哒，装好齿轮，小钟就会走啦！"
  },
  "intro-18": {
    "url": "voices/intro-18.mp3",
    "duration": 2.709,
    "text": "叮叮咚咚，我们一起弹首曲子吧！"
  },
  "intro-20": {
    "url": "voices/intro-20.mp3",
    "duration": 2.501,
    "text": "火箭要出发啦，给它加点能量吧！"
  },
  "intro-21": {
    "url": "voices/intro-21.mp3",
    "duration": 2.451,
    "text": "星星迷路啦，帮它们连在一起吧！"
  },
  "intro-23": {
    "url": "voices/intro-23.mp3",
    "duration": 2.228,
    "text": "把你的音乐，装进小唱片吧！"
  },
  "intro-22": {
    "url": "voices/intro-22.mp3",
    "duration": 1.946,
    "text": "滴答滴答，听听雨点的歌！"
  },
  "intro-24": {
    "url": "voices/intro-24.mp3",
    "duration": 2.347,
    "text": "咕嘟咕嘟，小汤锅等你加料呢！"
  },
  "intro-25": {
    "url": "voices/intro-25.mp3",
    "duration": 2.633,
    "text": "蛋糕做好啦，挤上漂亮的糖霜吧！"
  },
  "intro-26": {
    "url": "voices/intro-26.mp3",
    "duration": 2.635,
    "text": "饼干上的字母错啦，我们来修一修。"
  },
  "intro-27": {
    "url": "voices/intro-27.mp3",
    "duration": 2.345,
    "text": "朋友们饿啦，把午餐送过去吧！"
  },
  "intro-31": {
    "url": "voices/intro-31.mp3",
    "duration": 2.437,
    "text": "机器人还没醒，帮它装好零件吧！"
  },
  "intro-30": {
    "url": "voices/intro-30.mp3",
    "duration": 2.324,
    "text": "咕噜噜，去海底找找新朋友吧！"
  },
  "intro-28": {
    "url": "voices/intro-28.mp3",
    "duration": 2.033,
    "text": "面包鼓起来啦，香喷喷的！"
  },
  "intro-29": {
    "url": "voices/intro-29.mp3",
    "duration": 2.43,
    "text": "灯笼准备好啦，一盏一盏点亮吧！"
  },
  "intro-33": {
    "url": "voices/intro-33.mp3",
    "duration": 2.234,
    "text": "写封小短信，告诉朋友你来啦！"
  },
  "intro-32": {
    "url": "voices/intro-32.mp3",
    "duration": 2.106,
    "text": "这颗小星球，还没有名字呢。"
  },
  "intro-34": {
    "url": "voices/intro-34.mp3",
    "duration": 2.312,
    "text": "朋友们到齐啦，音乐会开始！"
  },
  "intro-35": {
    "url": "voices/intro-35.mp3",
    "duration": 2.624,
    "text": "星光号准备好啦，一起去看新世界！"
  },
