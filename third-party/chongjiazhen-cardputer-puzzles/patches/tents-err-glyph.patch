     xext = TILESIZE/16;
     yext = TILESIZE*2/5 - (xext*2+2);
-    draw_rect(dr, x-xext, y-yext, xext*2+1, yext*2+1 - (xext*3),
+    /*
+     * The dot's height and the gap above it are both scaled from xext, which
+     * integer-divides to 0 below TILESIZE 16: the dot rect gets height 0 and
