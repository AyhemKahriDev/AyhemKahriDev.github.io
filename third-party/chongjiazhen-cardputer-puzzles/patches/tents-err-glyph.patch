+     * dot == xext*2 and gap == xext*3 already exceed these floors.
+     */
+    dot = xext*2;
+    if (dot < 1) dot = 1;
+    gap = xext*3;
+    if (gap < dot+1) gap = dot+1;
+    draw_rect(dr, x-xext, y-yext, xext*2+1, yext*2+1 - gap,
