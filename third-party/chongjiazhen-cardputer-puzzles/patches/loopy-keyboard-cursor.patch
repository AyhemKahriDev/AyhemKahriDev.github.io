+/*
+ * Move the edge cursor one step in the direction of a cursor key.
+ *
+ * Candidates are restricted to edges sharing a dot with the current edge.
+ * That keeps movement local, guarantees the cursor can always reach a
+ * perpendicular edge (a whole-grid nearest-in-direction search cannot: on a
+ * square grid every direction from a horizontal edge finds another horizontal
+ * edge first, trapping the cursor in one sublattice), and needs nothing but
+ * grid adjacency, so it behaves sensibly on triangular, honeycomb, Penrose
+ * and hat/spectre grids too.
+ *
+ * Among those candidates, take the one whose midpoint offset is most nearly
+ * parallel to the pressed direction: smallest perpendicular component, ties
+ * broken by the nearest. Returns -1 if nothing lies that way.
+ */
+static int loopy_cursor_neighbour(grid *g, int cur, int button)
+{
+    grid_edge *e = g->edges[cur];
+    /* Work in doubled coordinates throughout, so midpoints stay exact. */
+    long cx = (long)e->dot1->x + e->dot2->x, cy = (long)e->dot1->y + e->dot2->y;
+    long dx = (button == CURSOR_RIGHT) ? 1 : (button == CURSOR_LEFT) ? -1 : 0;
+    long dy = (button == CURSOR_DOWN)  ? 1 : (button == CURSOR_UP)   ? -1 : 0;
+    long bestperp = 0, bestalong = 0;
+    int best = -1, d, j;
+
+    for (d = 0; d < 2; d++) {
+        grid_dot *dot = (d == 0) ? e->dot1 : e->dot2;
+        for (j = 0; j < dot->order; j++) {
+            grid_edge *c = dot->edges[j];
+            long mx, my, along, perp;
+
+            if (c == e)
+                continue;
+            mx = (long)c->dot1->x + c->dot2->x - cx;
+            my = (long)c->dot1->y + c->dot2->y - cy;
+            along = mx * dx + my * dy;
+            if (along <= 0)
+                continue;               /* not in the pressed direction */
+            perp = mx * dy - my * dx;
+            if (perp < 0)
+                perp = -perp;
+            if (best < 0 || perp < bestperp ||
+                (perp == bestperp && along < bestalong)) {
+                best = c->index;
+                bestperp = perp;
+                bestalong = along;
+            }
+        }
+    }
+    return best;
+}
