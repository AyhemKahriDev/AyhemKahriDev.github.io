{
  "name": "arcadefork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "arcadefork — a free browser arcade. Many games, many categories, zero cost to run.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-site.mjs",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "daily": "node scripts/daily.mjs",
    "vendor:games": "node scripts/vendor-games.mjs",
    "harvest": "node scripts/harvest-games.mjs all",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "package:itch": "node scripts/package-itch.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "check:mobile": "node scripts/mobile-check.mjs",
    "themes": "node scripts/theme-contrast.mjs",
    "fix:embeds": "node scripts/embed-fixes.mjs",
    "og:image": "node scripts/og-image.mjs",
    "audit": "npm run audit:links && npm run audit:embeds && npm run audit:assets && npm run audit:health",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:embeds": "node scripts/audit-embeds.mjs",
    "audit:assets": "node scripts/audit-embed-assets.mjs",
    "audit:health": "node scripts/audit-embed-health.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
