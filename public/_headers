# The hashed game bundle gets its own exact rule, generated by
# scripts/build-site.mjs from the filename that build actually emitted - see
# writeHeaders(). A wildcard here cannot work: Cloudflare's glob treats
# `/assets/host.*.js` as matching `/assets/host.js` too, so the two policies
# merge into `max-age=0, must-revalidate, max-age=31536000, immutable` and a
# browser may honour the year.
/assets/host.js
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=2592000

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/fonts.css
  Cache-Control: public, max-age=0, must-revalidate

/ui.js
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=2592000

# No CSP on this catch-all on purpose: Cloudflare applies every matching rule and
# two CSP headers intersect, so a permissive /third-party/* rule could never
# relax a global one. The strict policy for the arcade's own pages is a meta tag
# emitted by scripts/shell.mjs; the permissive policy for games is below.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vendored games are foreign code and they behave like it: they load Phaser and
# p5 from a CDN, compile with emscripten or eval in Cocos, pull fonts and
# bootstrap. The strict policy above killed every one of those - measured
# 2026-10-30, roughly one vendored game in eight rendered a blank frame because
# its engine was blocked. So the game subtree gets a policy that lets the game
# run, and containment moves to where it actually belongs: the iframe in
# scripts/shell.mjs carries sandbox="allow-scripts allow-same-origin ...", there
# is no top navigation and no access to the arcade's own pages.
#
# Why this is not a hole in the product: the relaxed policy applies only to
# /third-party/* documents, which are never the page the visitor navigates - the
# arcade shell, the catalogue, the daily puzzle and the credits keep the strict
# policy. A game cannot use these origins to change our HTML because it is not
# our origin's author; it is a frame.
/third-party/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline' https: http:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http:; font-src 'self' data: https: http:; media-src 'self' data: blob: https: http:; connect-src 'self' blob: data: https: http: ws: wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'
