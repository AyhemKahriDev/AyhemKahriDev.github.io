# Two disjoint patterns on purpose. Cloudflare Pages merges every rule whose
# path matches, so `/assets/host.js` plus `/assets/*` produced a single header
# reading `max-age=0, must-revalidate, max-age=31536000, immutable` - the exact
# contradiction that pinned the game bundle for a year. Nothing overlaps here:
# the hashed entry is immutable, the transitional copy revalidates. Any other
# file under /assets/ falls back to Cloudflare's default, which revalidates.
/assets/host.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/host.*.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/fonts.css
  Cache-Control: public, max-age=0, must-revalidate

/ui.js
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
