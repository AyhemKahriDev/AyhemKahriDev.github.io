# The hashed game bundle gets its own exact rule, generated by
# scripts/build-site.mjs from the filename that build actually emitted - see
# writeHeaders(). A wildcard here cannot work: Cloudflare's glob treats
# `/assets/host.*.js` as matching `/assets/host.js` too, so the two policies
# merge into `max-age=0, must-revalidate, max-age=31536000, immutable` and a
# browser may honour the year.
/assets/host.js
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=2592000

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/fonts.css
  Cache-Control: public, max-age=0, must-revalidate

/ui.js
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
