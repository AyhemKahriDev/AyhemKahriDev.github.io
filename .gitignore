node_modules/
# Only the top-level build output. A vendored game may have its own dist/
# folder - that is the game's compiled source, and without it the game is
# broken in a fresh clone.
/dist/
.wrangler/
.DS_Store
*.log
.env
.env.*
!.env.example
.smoke/

.dev.vars*
!.dev.vars.example
.harvest/
.og-card.rendered.html

# Local scratch harnesses: one-off puppeteer/screenshot scripts at the repo
# root. They are written with a leading dot so this rule cannot ever match a
# real script under scripts/.
/.*.mjs

# Local Hermes plans and scratch
.hermes/
